# Copy this file to .env and fill in your values. Never commit .env.

# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID (Developer Mode on, right-click the server icon -> Copy Server ID).
# When set, slash commands show up there instantly.
DISCORD_GUILD_ID=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Your name and contact email, which SEC requires in the User-Agent of every request.
# Used by the latency recorder, and later by the bot itself.
SEC_USER_AGENT=

# For watching a schedule (`uv run earnings-bot schedules/<day>.toml`):
# The channel releases get posted in (Developer Mode on, right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Writes the summaries: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Consensus estimates: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
