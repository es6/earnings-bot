# Copy this file to .env and fill in your values. Never commit .env.

# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID (Developer Mode on, right-click the server icon -> Copy Server ID).
# When set, slash commands show up there instantly.
DISCORD_GUILD_ID=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Your name and contact email, which SEC requires in the User-Agent of every request.
# Used by the latency recorder, and later by the bot itself.
SEC_USER_AGENT=

# For watching a schedule (`uv run earnings-bot schedules/<day>.toml`):
# The channel releases get posted in (Developer Mode on, right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Optional, separate channel for the unattended watcher and window reports
DISCORD_STATUS_CHANNEL_ID=
# Muse Ember low summaries through Meta's Model API; a key alone does not enable them.
LIVE_SUMMARIES=false
META_MODEL_API_KEY=
# Optional paid prior-release profiles during /track research. Requires live summaries.
# At most five profile calls and $0.50 reserved per day; off pending evaluation.
LIVE_DRIVER_PROFILES=false
# Experimental reference-bound writer. Leave off pending final-coverage review.
SOURCE_REFERENCED_SUMMARIES=false
# Optional earnings-calendar dates for tracked companies:
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# The watchdog's alarms (earnings-bot-watchdog): a channel's Integrations -> Webhooks -> URL
WATCHDOG_WEBHOOK_URL=
